{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learn",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "LEARN_DB",
      "database_name": "learn-db",
      "database_id": "replace-with-cloudflare-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LEARN_FILES",
      "bucket_name": "learn-files"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "learn-next-cache"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ID": "learn",
    "APP_BASE_URL": "https://learn.example.com",
    "AI_PROVIDER_DEFAULT": "cloudflare",
    "CLOUDFLARE_D1_DATABASE_NAME": "learn-db",
    "CLOUDFLARE_R2_BUCKET": "learn-files",
    "CLOUDFLARE_NEXT_CACHE_BUCKET": "learn-next-cache",
    "CLOUDFLARE_AI_GATEWAY_ID": "learn"
  }
}
