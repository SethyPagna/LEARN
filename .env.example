APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Cloudflare is the production backend. D1 and R2 are bindings in wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=learning-os
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_URL=

# Optional legacy local Postgres fallback for next dev without Cloudflare bindings.
DATABASE_URL=
DATABASE_SSL=false

# AI provider selection. Set only server-side in Cloudflare, local ignored env files, or platform secrets.
AI_PROVIDER_DEFAULT=cloudflare
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_AI_API_KEY=
COHERE_API_KEY=
VERCEL_AI_GATEWAY=

# Cloudflare D1/R2 resource names used by setup scripts and wrangler bindings.
CLOUDFLARE_D1_DATABASE=learning-os-db
CLOUDFLARE_R2_BUCKET=learning-os-files
CLOUDFLARE_NEXT_CACHE_BUCKET=learning-os-next-cache

# Cloudflare try-run. Keep tokens in ignored local env/runtime only.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
