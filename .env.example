APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://learning_os:learning_os_password@localhost:5432/learning_os
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-long-random-secret

# AI provider selection. Set only server-side in Vercel, Docker env, or local ignored env files.
AI_PROVIDER_DEFAULT=groq
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_AI_API_KEY=
COHERE_API_KEY=
VERCEL_AI_GATEWAY=

# Object-storage references for Docker-compatible file storage.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=learning-os
S3_ACCESS_KEY_ID=learning_os_minio
S3_SECRET_ACCESS_KEY=learning_os_minio_password

# Cloudflare try-run. Keep tokens in ignored local env/runtime only.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
