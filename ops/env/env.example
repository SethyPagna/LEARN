APP_BASE_URL=http://localhost:3000
APP_ID=learn
SESSION_SECRET=replace-with-a-long-random-secret

# Cloudflare is the production backend. Workers use bindings; Vercel/Docker use API credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=learn-db
CLOUDFLARE_R2_BUCKET=learn-files
CLOUDFLARE_NEXT_CACHE_BUCKET=learn-next-cache
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_AI_GATEWAY_ID=learn
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_URL=

# AI provider selection. Set only server-side in Cloudflare, local ignored env files, or platform secrets.
AI_PROVIDER_DEFAULT=cloudflare
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_AI_API_KEY=
COHERE_API_KEY=
VERCEL_AI_GATEWAY=

# Cloudflare try-run. Keep tokens in ignored local env/runtime only.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
